basePath: /api
definitions:
  rating:
    properties:
      from_user:
        type: string
      rating:
        type: number
      rating_id:
        type: integer
      to_user:
        type: string
    type: object
host: localhost:8008
info:
  contact: {}
  description: '%README_FILE%'
  title: Authentication API
  version: "3.0"
paths:
  /api/ratings/{username}:
    get:
      description: При обращении, возвращаются все ответы, которые есть у username
      parameters:
      - description: ID пользователя
        in: path
        name: username
        required: true
        type: string
      produces:
      - application/json
      responses:
        "200":
          description: Запрос выполнен успешно
          schema:
            items:
              $ref: '#/definitions/rating'
            type: array
        "400":
          description: Ошибка валидации данных
        "401":
          description: Ошибка авторизации
        "500":
          description: Произошла внутренняя ошибка сервера
      summary: Получение ответов по username
      tags:
      - APIs
  /api/ratings/addRating:
    post:
      description: При обращении, добавляется отклик в БД по телу запрсоа
      parameters:
      - description: Тело запроса
        in: body
        name: request
        required: true
        schema:
          $ref: '#/definitions/rating'
      produces:
      - application/json
      responses:
        "200":
          description: Запрос выполнен успешно
        "400":
          description: Ошибка валидации данных
        "401":
          description: Ошибка авторизации
        "500":
          description: Произошла внутренняя ошибка сервера
      summary: Добавление отклика в БД
      tags:
      - APIs
swagger: "2.0"
